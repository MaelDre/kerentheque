# Copier ce fichier en .env (ou définir ces variables dans l'hébergeur).

# Mettre à true uniquement en développement local.
DEBUG=true

# Obligatoire en production (générer une valeur longue et aléatoire).
SECRET_KEY=

# Noms d'hôte autorisés, séparés par des virgules.
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance pour le CSRF en HTTPS, ex. https://kerentheque.example
CSRF_TRUSTED_ORIGINS=

# URL publique du site, utilisée dans les liens des emails.
SITE_URL=http://localhost:8000

# Chemin du fichier SQLite (à placer sur un volume persistant en production).
DATABASE_PATH=

# Emails. Sans EMAIL_HOST, les emails sont affichés dans la console.
DEFAULT_FROM_EMAIL="Kerentheque <noreply@localhost>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
